# Spring Profile
PROFILE=prod

# Database
SPRING_DATASOURCE_URL=jdbc:mysql://host.docker.internal:3306/postit_db?autoReconnect=true&useSSL=false&connectTimeout=30000&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=dbuser
SPRING_DATASOURCE_PASSWORD=dbpassword

MYSQL_USERNAME=dbuser
MYSQL_PASSWORD=dbpassword
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_DB=db_name

# Redis
REDIS_HOST=host.docker.internal
REDIS_PORT=6379가

# JWT
JWT_SECRET_KEY=jwt_secret_key

# Google OAuth2
GOOGLE_CLIENT_ID=google_client_id
GOOGLE_CLIENT_SECRET=google_client_secret
GOOGLE_REDIRECT_URI=https://www.example.com/callbackuri

# Logging
LOG_FILE=/var/log/app-logs/postit.log
LOGGING_FILE_NAME=/var/log/app-logs/postit.log

# Frontend URL
MAIN_PAGE=https://post-it-00-service.duckdns.org

# Docker
DOCKER_USERNAME=docker_username_id
SPRINGBOOT_IMAGE_TAG=latest
FLUTTER_IMAGE_TAG=latest